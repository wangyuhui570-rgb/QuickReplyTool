<Window x:Class="QuickReply.Desktop.FileLibraryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:models="clr-namespace:QuickReply.Desktop.Models"
        Title="文件库"
        Width="760"
        Height="480"
        MinWidth="680"
        MinHeight="420"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        Background="Transparent"
        FontFamily="Segoe UI Variable Text">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            CornerRadius="0"
                            GlassFrameThickness="0"
                            ResizeBorderThickness="6"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <StaticResource x:Key="TitleBrush" ResourceKey="AppleTitleBrush" />
        <StaticResource x:Key="TextBrush" ResourceKey="AppleTextBrush" />
        <StaticResource x:Key="MutedBrush" ResourceKey="AppleMutedBrush" />

        <Style x:Key="SummaryCardStyle"
               TargetType="Border"
               BasedOn="{StaticResource AppleEditorHeaderCardStyle}">
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>

        <Style x:Key="FooterBarStyle"
               TargetType="Border"
               BasedOn="{StaticResource AppleDialogFooterBarStyle}">
            <Setter Property="Margin" Value="0,12,0,0" />
        </Style>

        <Style x:Key="ActionButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource AppleSecondaryButtonStyle}" />

        <Style x:Key="PrimaryButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource ApplePrimaryButtonStyle}" />

        <Style x:Key="FileListBoxStyle" TargetType="ListBox">
            <Setter Property="Background" Value="{StaticResource AppleSurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource AppleLineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="18">
                            <ScrollViewer Padding="{TemplateBinding Padding}"
                                          Focusable="False">
                                <ItemsPresenter />
                            </ScrollViewer>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FileListItemStyle" TargetType="ListBoxItem">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="ItemBorder"
                                Background="Transparent"
                                CornerRadius="16">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource AppleSelectionActiveBrush}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource AppleSelectionHoverBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Margin="12" Style="{StaticResource AppleWindowChromeStyle}">
        <Border Style="{StaticResource AppleWindowInnerPanelStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        Margin="0,0,0,12"
                        Style="{StaticResource SummaryCardStyle}"
                        MouseLeftButtonDown="TitleBar_OnMouseLeftButtonDown">
                    <StackPanel>
                        <TextBlock FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TitleBrush}"
                                   Text="文件库" />
                        <TextBlock Margin="0,4,0,0"
                                   Foreground="{StaticResource MutedBrush}"
                                   Text="把客服常用的图片、视频、文档集中放在这里，搜索时就能直接找到并发送。"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <ListBox x:Name="FileItemsList"
                         Grid.Row="1"
                         ItemsSource="{Binding FileItems}"
                         SelectedItem="{Binding SelectedFileItem, RelativeSource={RelativeSource AncestorType=Window}, Mode=TwoWay}"
                         Style="{StaticResource FileListBoxStyle}"
                         ItemContainerStyle="{StaticResource FileListItemStyle}">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type models:LibraryFileItem}">
                            <Border Padding="12,10"
                                    Style="{StaticResource AppleListItemCardStyle}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock FontWeight="SemiBold"
                                               Foreground="{StaticResource TitleBrush}"
                                               Text="{Binding DisplayName}" />
                                    <TextBlock Grid.Row="1"
                                               Margin="0,4,0,0"
                                               Foreground="{StaticResource MutedBrush}"
                                               Text="{Binding FullPath}"
                                               TextTrimming="CharacterEllipsis" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <Border Grid.Row="2" Style="{StaticResource FooterBarStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock x:Name="SummaryText"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource MutedBrush}" />

                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Width="96"
                                    Margin="0,0,8,0"
                                    Click="AddFilesButton_OnClick"
                                    Content="添加文件"
                                    Style="{StaticResource PrimaryButtonStyle}" />
                            <Button Width="96"
                                    Margin="0,0,8,0"
                                    Click="RemoveSelectedButton_OnClick"
                                    Content="移除选中"
                                    Style="{StaticResource ActionButtonStyle}" />
                            <Button Width="78"
                                    IsDefault="True"
                                    Click="CloseButton_OnClick"
                                    Content="关闭"
                                    Style="{StaticResource ActionButtonStyle}" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Border>
</Window>
