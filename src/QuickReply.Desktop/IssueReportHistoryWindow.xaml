<Window x:Class="QuickReply.Desktop.IssueReportHistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="问题记录历史"
        Width="740"
        Height="500"
        MinWidth="640"
        MinHeight="400"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="None"
        Background="Transparent"
        FontFamily="Segoe UI Variable Text">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            CornerRadius="0"
                            GlassFrameThickness="0"
                            ResizeBorderThickness="4"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <StaticResource x:Key="TitleBrush" ResourceKey="AppleTitleBrush" />
        <StaticResource x:Key="TextBrush" ResourceKey="AppleTextBrush" />
        <StaticResource x:Key="MutedBrush" ResourceKey="AppleMutedBrush" />
    </Window.Resources>

    <Border Margin="12" Style="{StaticResource AppleWindowChromeStyle}">
        <Border Style="{StaticResource AppleWindowInnerPanelStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="3*" />
                    <RowDefinition Height="2*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="4,2,4,12" MouseLeftButtonDown="TitleBar_OnMouseLeftButtonDown">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock VerticalAlignment="Center"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TitleBrush}"
                               Text="问题记录历史" />
                    <Button Grid.Column="1"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Click="CloseButton_OnClick"
                            ToolTip="关闭"
                            Style="{StaticResource AppleWindowCloseButtonStyle}" />
                </Grid>

                <Border Grid.Row="1"
                        Margin="0,0,0,8"
                        Style="{StaticResource AppleCompactDialogBodyCardStyle}">
                    <ListView x:Name="EntriesListView"
                              Background="Transparent"
                              BorderThickness="0"
                              SelectionChanged="EntriesListView_OnSelectionChanged">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="时间" Width="140" DisplayMemberBinding="{Binding CreatedAtText}" />
                                <GridViewColumn Header="问题描述" Width="380" DisplayMemberBinding="{Binding DescriptionSummary}" />
                                <GridViewColumn Header="状态" Width="120" DisplayMemberBinding="{Binding StatusText}" />
                            </GridView>
                        </ListView.View>
                    </ListView>
                </Border>

                <Border Grid.Row="2"
                        Style="{StaticResource AppleCompactDialogBodyCardStyle}">
                    <TextBox x:Name="DetailTextBox"
                             IsReadOnly="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             Background="Transparent"
                             BorderThickness="0"
                             FontSize="12"
                             Foreground="{DynamicResource AppleTextBrush}"
                             Text="选择一条问题记录后查看详细信息。" />
                </Border>

                <Border Grid.Row="3"
                        Style="{StaticResource AppleDialogFooterBarStyle}">
                    <DockPanel LastChildFill="False">
                        <Button DockPanel.Dock="Left"
                                MinWidth="110"
                                Click="OpenDirectoryButton_OnClick"
                                Content="打开存储目录"
                                Style="{StaticResource AppleSecondaryButtonStyle}" />
                        <Button DockPanel.Dock="Right"
                                Width="84"
                                Click="CloseButton_OnClick"
                                Content="关闭"
                                Style="{StaticResource AppleSecondaryButtonStyle}" />
                    </DockPanel>
                </Border>
            </Grid>
        </Border>
    </Border>
</Window>