                                                <StackPanel Grid.ColumnSpan="2" Margin="0,0,0,10">
                                                    <TextBlock Style="{StaticResource SectionTitleStyle}" Text="最近异常记录" />
                                                    <TextBlock Margin="0,5,0,0" Foreground="{StaticResource MutedBrush}" Text="这里会显示最近捕获到的异常，便于你定位现场问题和排查用户反馈。" TextWrapping="Wrap" />
                                                </StackPanel>
                                                <TextBlock Grid.Row="1" Style="{StaticResource FieldLabelStyle}" Text="异常列表" />
                                                <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,6,0,0">
                                                    <TextBlock Foreground="{StaticResource MutedBrush}" Text="{Binding ExceptionSummary}" />
                                                    <ItemsControl Margin="0,8,0,0" ItemsSource="{Binding RecentExceptionItems}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Border Margin="0,0,0,8" Style="{StaticResource AppleInsetCardStyle}">
                                                                    <StackPanel>
                                                                        <DockPanel>
                                                                            <TextBlock DockPanel.Dock="Left" FontWeight="SemiBold" Foreground="{StaticResource TitleBrush}" Text="{Binding ExceptionType}" />
                                                                            <Border DockPanel.Dock="Right" Style="{StaticResource AppleDangerBadgeStyle}" Visibility="{Binding IsTerminating, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                                                <TextBlock Style="{StaticResource AppleDangerBadgeTextStyle}" Text="导致退出" />
                                                                            </Border>
                                                                        </DockPanel>
                                                                        <TextBlock Margin="0,6,0,0" Foreground="{StaticResource TextBrush}" Text="{Binding Message}" TextWrapping="Wrap" />
                                                                        <TextBlock Margin="0,6,0,0" FontSize="11" Foreground="{StaticResource MutedBrush}" Text="{Binding SourceText}" />
                                                                        <TextBlock Margin="0,4,0,0" FontSize="11" Foreground="{StaticResource MutedBrush}" Text="{Binding OccurredAtText}" />
                                                                        <TextBlock Margin="0,4,0,0" FontSize="11" Foreground="{StaticResource MutedBrush}" Text="{Binding ContextText}" TextWrapping="Wrap">
                                                                            <TextBlock.Style>
                                                                                <Style TargetType="TextBlock">
                                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                                    <Style.Triggers>
                                                                                        <DataTrigger Binding="{Binding ContextText}" Value="">
                                                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                                                        </DataTrigger>
                                                                                    </Style.Triggers>
                                                                                </Style>
                                                                            </TextBlock.Style>
                                                                        </TextBlock>
                                                                    </StackPanel>
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                    <TextBlock Foreground="{StaticResource MutedBrush}" Text="{Binding ExceptionEmptyMessage}">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding HasRecentExceptionItems}" Value="True">
                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                    <StackPanel Margin="0,10,0,0" Orientation="Horizontal">
                                                        <Button Width="118" Margin="0,0,10,0" Click="OpenExceptionFolderButton_OnClick" Content="打开异常目录" Style="{StaticResource SubtleButtonStyle}" />
                                                        <Button Width="118" Click="ClearExceptionLogsButton_OnClick" Content="清空异常记录" Style="{StaticResource SubtleButtonStyle}" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                        <Border Style="{StaticResource SectionCardStyle}"><StackPanel><TextBlock Style="{StaticResource SectionTitleStyle}" Text="诊断建议" /><TextBlock Margin="0,8,0,0" Foreground="{StaticResource MutedBrush}" Text="1. 平时主要看截图占用和本次启动记录数，确认日志有没有持续落库。" TextWrapping="Wrap" /><TextBlock Margin="0,6,0,0" Foreground="{StaticResource MutedBrush}" Text="2. 文本日志更适合回看发送行为；截图更多是排查和抽样核对用。" TextWrapping="Wrap" /><TextBlock Margin="0,6,0,0" Foreground="{StaticResource MutedBrush}" Text="3. 当你觉得占用变大时，先点一次“立即清理旧截图”，通常不需要手动删数据库。" TextWrapping="Wrap" /></StackPanel></Border>
                                        <Border x:Name="DataSection" Style="{StaticResource SectionCardStyle}">
                                            <Grid>
                                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="140" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                                <StackPanel Grid.ColumnSpan="2" Margin="0,0,0,10"><TextBlock Style="{StaticResource SectionTitleStyle}" Text="数据与导入导出" /><TextBlock Margin="0,5,0,0" Foreground="{StaticResource MutedBrush}" Text="把导入导出、目录查看和恢复默认统一放到最后，避免和日常设置混在一起。" TextWrapping="Wrap" /></StackPanel>
                                                <TextBlock Grid.Row="1" Style="{StaticResource FieldLabelStyle}" Text="短语迁移" />
                                                <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal"><Button Width="132" Margin="0,0,10,0" Click="ExportPhrasesButton_OnClick" Content="导出短语 xls/csv" Style="{StaticResource SubtleButtonStyle}" /><Button Width="132" Click="ImportPhrasesButton_OnClick" Content="导入短语 xls/csv" Style="{StaticResource PrimaryButtonStyle}" /></StackPanel>
                                                <TextBlock Grid.Row="2" Style="{StaticResource FieldLabelStyle}" Text="短语整理" />
                                                <StackPanel Grid.Row="2" Grid.Column="1" Margin="0,6,0,0">
                                                    <Button Width="152" HorizontalAlignment="Left" Click="CleanupPhrasesButton_OnClick" Content="整理快捷短语" Style="{StaticResource SubtleButtonStyle}" />
                                                    <TextBlock Margin="0,8,0,0" Foreground="{StaticResource MutedBrush}" Text="自动找出完全重复和内容相似的快捷短语，由你手动勾选删除多余项。" TextWrapping="Wrap" />
                                                </StackPanel>
                                                <TextBlock Grid.Row="3" Style="{StaticResource FieldLabelStyle}" Text="个人配置迁移" />
                                                <StackPanel Grid.Row="3" Grid.Column="1" Margin="0,6,0,0">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Button Width="142" Margin="0,0,10,0" Click="ExportPersonalConfigButton_OnClick" Content="导出全部个人配置" Style="{StaticResource SubtleButtonStyle}" />
                                                        <Button Width="142" Click="ImportPersonalConfigButton_OnClick" Content="导入全部个人配置" Style="{StaticResource PrimaryButtonStyle}" />
                                                    </StackPanel>
                                                    <TextBlock Margin="0,8,0,0" Foreground="{StaticResource MutedBrush}" Text="会处理热键、发送设置、颜色主题、文件资料目录等个人配置。" TextWrapping="Wrap" />
                                                </StackPanel>
                                                <TextBlock Grid.Row="4" Style="{StaticResource FieldLabelStyle}" Text="数据目录" />
                                                <StackPanel Grid.Row="4" Grid.Column="1" Margin="0,6,0,0"><TextBlock Text="{Binding UserDataFolderSummary}" TextWrapping="Wrap" /><Button Width="152" Margin="0,10,0,0" HorizontalAlignment="Left" Click="OpenUserDataFolderButton_OnClick" Content="打开用户数据文件夹" Style="{StaticResource SubtleButtonStyle}" /></StackPanel>
                                                <TextBlock Grid.Row="5" Style="{StaticResource FieldLabelStyle}" Text="示例与文件库" />
                                                <StackPanel Grid.Row="5" Grid.Column="1" Margin="0,6,0,0" Orientation="Horizontal"><Button Width="152" Margin="0,0,10,0" Click="ResetPhraseDataButton_OnClick" Content="恢复默认示例短语" Style="{StaticResource SubtleButtonStyle}" /><Button Width="140" Click="ClearFileLibraryConfigurationButton_OnClick" Content="清空文件库配置" Style="{StaticResource SubtleButtonStyle}" /></StackPanel>
                                                <TextBlock Grid.Row="6" Style="{StaticResource FieldLabelStyle}" Text="恢复默认" />
                                                <StackPanel Grid.Row="6" Grid.Column="1" Margin="0,6,0,0"><Button Width="168" HorizontalAlignment="Left" Click="ResetPersonalizationButton_OnClick" Content="恢复默认个性化配置" Style="{StaticResource PrimaryButtonStyle}" /><TextBlock Margin="0,8,0,0" Foreground="{StaticResource MutedBrush}" Text="会恢复热键、颜色、透明度、延迟、搜索模式等默认值，但保留文件库路径和短语图片目录。" TextWrapping="Wrap" /></StackPanel>
                                            </Grid>
                                        </Border>
                                    </StackPanel>
                                </ScrollViewer>
                            </Border>
                        </Grid>
                    </TabItem>
                    </TabControl>
                </Grid>
            </Border>
            <Border Grid.Row="1" Margin="0,12,0,0" Padding="14" Style="{StaticResource SurfaceCardStyle}">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Foreground="{StaticResource MutedBrush}" Text="保存后会应用到当前会话。" />
                        <TextBlock Margin="0,6,0,0"
                                   Foreground="{StaticResource AppleDangerBadgeForegroundBrush}"
                                   Text="{Binding ValidationSummary}"
                                   TextWrapping="Wrap">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasValidationErrors}" Value="False">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Width="92" Margin="0,0,10,0" Click="CancelButton_OnClick" Content="取消" Style="{StaticResource SubtleButtonStyle}" />
                        <Button Width="104"
                                Click="SaveButton_OnClick"
                                Content="保存设置"
                                IsEnabled="{Binding CanSave}"
                                Style="{StaticResource PrimaryButtonStyle}" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
