<Window x:Class="QuickReply.Desktop.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="clr-namespace:QuickReply.Desktop.Models"
    Title="设置"
    Icon="pack://application:,,,/Assets/quickreply.ico"
    Width="860" Height="800" MinWidth="760" MinHeight="680"
    Background="Transparent" AllowsTransparency="True"
    FontFamily="Segoe UI Variable Text"
    Topmost="False"
    WindowStartupLocation="CenterOwner" ResizeMode="NoResize" WindowStyle="None">
    <Window.Resources>
        <StaticResource x:Key="WindowBackgroundBrush" ResourceKey="AppleWindowBackgroundBrush" />
        <StaticResource x:Key="SurfaceBrush" ResourceKey="AppleSurfaceBrush" />
        <StaticResource x:Key="SurfaceAltBrush" ResourceKey="AppleSurfaceAltBrush" />
        <StaticResource x:Key="LineBrush" ResourceKey="AppleLineBrush" />
        <StaticResource x:Key="StrongLineBrush" ResourceKey="AppleStrongLineBrush" />
        <StaticResource x:Key="AccentBrush" ResourceKey="AppleAccentBrush" />
        <StaticResource x:Key="TitleBrush" ResourceKey="AppleTitleBrush" />
        <StaticResource x:Key="TextBrush" ResourceKey="AppleTextBrush" />
        <StaticResource x:Key="MutedBrush" ResourceKey="AppleMutedBrush" />
        <StaticResource x:Key="CardShadowEffect" ResourceKey="AppleFloatingShadowEffect" />
        <Style x:Key="SurfaceCardStyle" TargetType="Border" BasedOn="{StaticResource AppleSurfaceCardStyle}" />
        <Style x:Key="SectionCardStyle" TargetType="Border" BasedOn="{StaticResource AppleSectionCardStyle}" />
        <Style x:Key="SectionTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource AppleSectionTitleStyle}" />
        <Style x:Key="FieldLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource AppleFieldLabelStyle}" />
        <Style x:Key="InputTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource AppleInputTextBoxStyle}" />
        <Style x:Key="InputComboBoxStyle" TargetType="ComboBox" BasedOn="{StaticResource AppleInputComboBoxStyle}" />
        <Style x:Key="SubtleButtonStyle" TargetType="Button" BasedOn="{StaticResource AppleSecondaryButtonStyle}" />
        <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource ApplePrimaryButtonStyle}" />
        <Style x:Key="NavButtonBaseStyle" TargetType="Button" BasedOn="{StaticResource AppleNavButtonStyle}" />
        <Style x:Key="OptionsTabControlStyle" TargetType="TabControl" BasedOn="{StaticResource AppleTabControlStyle}" />
        <Style x:Key="OptionsTabItemStyle" TargetType="TabItem" BasedOn="{StaticResource AppleTabItemStyle}" />
    </Window.Resources>
    <Border Style="{StaticResource AppleWindowChromeStyle}">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <Border Grid.Row="0" Style="{StaticResource AppleWindowInnerPanelStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="2,2,2,12" MouseLeftButtonDown="TitleBar_OnMouseLeftButtonDown">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center"
                                   FontSize="13"
                                   Foreground="{StaticResource MutedBrush}"
                                   Text="设置" />
                        <Button Grid.Column="1"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Click="CloseButton_OnClick"
                                ToolTip="关闭设置"
                                Style="{StaticResource AppleWindowCloseButtonStyle}" />
                    </Grid>
                    <TabControl Grid.Row="1" Margin="0" Style="{StaticResource OptionsTabControlStyle}">
                    <TabItem Header="常用设置" Style="{StaticResource OptionsTabItemStyle}">
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="204" /><ColumnDefinition Width="16" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Padding="12" Style="{StaticResource SurfaceCardStyle}">
                                <StackPanel>
                                    <TextBlock Margin="0,0,0,12" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TitleBrush}" Text="常用设置" />
                                     <Button x:Name="GeneralNavButton" Tag="general" Click="NavigateButton_OnClick" Content="通用" Style="{StaticResource NavButtonBaseStyle}" />
                                     <Button x:Name="StabilityNavButton" Tag="search" Click="NavigateButton_OnClick" Content="搜索与推荐" Style="{StaticResource NavButtonBaseStyle}" />
                                     <Button x:Name="QuickActionsNavButton" Tag="quick-actions" Click="NavigateButton_OnClick" Content="快捷发送" Style="{StaticResource NavButtonBaseStyle}" />
                                     <Button x:Name="DelayNavButton" Tag="delay-control" Click="NavigateButton_OnClick" Content="延迟控制" Style="{StaticResource NavButtonBaseStyle}" />
                                     <Button x:Name="AppearanceNavButton" Tag="appearance" Click="NavigateButton_OnClick" Content="侧栏与界面" Style="{StaticResource NavButtonBaseStyle}" />
                                     <Button x:Name="FilesNavButton" Tag="files" Click="NavigateButton_OnClick" Content="文件与素材" Style="{StaticResource NavButtonBaseStyle}" />
                                 </StackPanel>
                             </Border>
                            <Border Grid.Column="2" Padding="10" Style="{StaticResource SurfaceCardStyle}">
                                <ScrollViewer x:Name="SettingsScrollViewer" VerticalScrollBarVisibility="Auto" ScrollChanged="SettingsScrollViewer_OnScrollChanged">
                                    <StackPanel x:Name="ContentStack">
                                        <Border x:Name="GeneralSection" Tag="general" Style="{StaticResource SectionCardStyle}">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="140" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.ColumnSpan="2" Margin="0,0,0,10">
                                                    <TextBlock Style="{StaticResource SectionTitleStyle}" Text="通用" />
                                                </StackPanel>
                                                <TextBlock Grid.Row="1" Style="{StaticResource FieldLabelStyle}" Text="工作模式" />
                                                <ComboBox Grid.Row="1" Grid.Column="1" Margin="0,4,0,0" Style="{StaticResource InputComboBoxStyle}" SelectedValue="{Binding SelectedSidebarWorkMode}" SelectedValuePath="Tag" ToolTip="精简模式下侧栏自动隐藏，纯快捷搜发；标准模式下短语栏会自动吸附在聊天窗口旁">
                                                    <ComboBoxItem Tag="{x:Static models:SidebarWorkMode.Standard}" Content="标准模式（显示吸附侧栏，支持短语列表点击与分类）" />
                                                    <ComboBoxItem Tag="{x:Static models:SidebarWorkMode.Compact}" Content="精简模式（完全隐藏侧栏，纯快捷搜发，极简无干扰）" />
                                                </ComboBox>
                                                <TextBlock Grid.Row="2" Style="{StaticResource FieldLabelStyle}" Text="搜索唤起" />
                                                <ComboBox Grid.Row="2" Grid.Column="1" Style="{StaticResource InputComboBoxStyle}" SelectedValue="{Binding SelectedSearchHotkeyMode}" SelectedValuePath="Tag">
                                                    <ComboBoxItem Tag="{x:Static models:SearchFocusHotkeyMode.Tab}" Content="Tab" />
                                                    <ComboBoxItem Tag="{x:Static models:SearchFocusHotkeyMode.DoubleCtrl}" Content="双击 Ctrl" />
                                                    <ComboBoxItem Tag="{x:Static models:SearchFocusHotkeyMode.AltQ}" Content="Alt+Q" />
                                                </ComboBox>
                                                <TextBlock Grid.Row="3" Style="{StaticResource FieldLabelStyle}" Text="开机启动" />
                                                <CheckBox Grid.Row="3" Grid.Column="1" Margin="0,6,0,0" IsChecked="{Binding SelectedLaunchAtStartup}" Content="开机自动启动 QuickReplyTool" ToolTip="开启后随 Windows 登录自动启动" />
                                                <TextBlock Grid.Row="4" Style="{StaticResource FieldLabelStyle}" Text="管理员权限" />
                                                <CheckBox Grid.Row="4" Grid.Column="1" Margin="0,6,0,0" IsChecked="{Binding SelectedRunAsAdministrator}" Content="始终以管理员权限启动 QuickReplyTool" ToolTip="若飞鸽/千牛以管理员身份运行，本工具也必须以管理员运行才能模拟按键发送。与部分普通权限远程协助工具可能不兼容。" />
                                                <TextBlock Grid.Row="5" Style="{StaticResource FieldLabelStyle}" Text="截图工具" />
                                                <CheckBox Grid.Row="5" Grid.Column="1" Margin="0,6,0,0" IsChecked="{Binding SelectedLaunchScreenshotToolWithApp}" Content="启动客服效率工具时，同时启动截图工具" ToolTip="截图功能由主程序统一托管，保存设置后生效" />
                                                <TextBlock Grid.Row="6" Style="{StaticResource FieldLabelStyle}" Text="截图快捷键" />
                                                <StackPanel Grid.Row="6" Grid.Column="1" Margin="0,6,0,0">
                                                    <Border Width="220" Padding="12,10" Style="{StaticResource AppleInsetCardStyle}">
                                                        <TextBlock Text="{Binding SelectedScreenshotToolHotkey}" />
                                                    </Border>
                                                    <StackPanel Margin="0,10,0,0" Orientation="Horizontal">
                                                        <Button Width="108" Margin="0,0,8,0" Click="ChangeScreenshotToolHotkeyButton_OnClick" Content="更改快捷键" Style="{StaticResource SubtleButtonStyle}" ToolTip="点击后直接按下新快捷键（需含修饰键，支持字母、数字、F1-F24等）" />
                                                        <Button Width="108" Click="ResetScreenshotToolHotkeyButton_OnClick" Content="恢复默认" Style="{StaticResource SubtleButtonStyle}" />
                                                    </StackPanel>
                                                </StackPanel>
                                                <TextBlock Grid.Row="7" Style="{StaticResource FieldLabelStyle}" Text="截图默认保存目录" />
                                                <StackPanel Grid.Row="7" Grid.Column="1" Margin="0,6,0,0">
                                                    <Border Padding="12,10" Style="{StaticResource AppleInsetCardStyle}">
                                                        <TextBlock Text="{Binding ScreenshotToolSaveDirectorySummary}" TextWrapping="Wrap" />
                                                    </Border>
                                                    <StackPanel Margin="0,10,0,0" Orientation="Horizontal">
                                                        <Button Width="116" Margin="0,0,8,0" Click="SelectScreenshotToolSaveDirectoryButton_OnClick" Content="选择文件夹" Style="{StaticResource SubtleButtonStyle}" />
                                                        <Button Width="108" Margin="0,0,8,0" Click="OpenScreenshotToolSaveDirectoryButton_OnClick" Content="打开当前目录" Style="{StaticResource SubtleButtonStyle}" />
                                                        <Button Width="108" Click="UseDefaultScreenshotToolSaveDirectoryButton_OnClick" Content="恢复默认目录" Style="{StaticResource SubtleButtonStyle}" />
                                                    </StackPanel>
                                                </StackPanel>
                                                <TextBlock Grid.Row="8" Style="{StaticResource FieldLabelStyle}" Text="问题反馈目录" />
                                                <StackPanel Grid.Row="8" Grid.Column="1" Margin="0,6,0,0">
                                                    <Border Padding="12,10" Style="{StaticResource AppleInsetCardStyle}">
                                                        <TextBlock Text="{Binding IssueReportDirectorySummary}" TextWrapping="Wrap" />
                                                    </Border>
                                                    <StackPanel Margin="0,10,0,0" Orientation="Horizontal">
                                                        <Button Width="116" Margin="0,0,8,0" Click="SelectIssueReportDirectoryButton_OnClick" Content="选择文件夹" Style="{StaticResource SubtleButtonStyle}" />
                                                        <Button Width="108" Margin="0,0,8,0" Click="OpenIssueReportDirectoryButton_OnClick" Content="打开当前目录" Style="{StaticResource SubtleButtonStyle}" />
                                                        <Button Width="108" Click="UseDefaultIssueReportDirectoryButton_OnClick" Content="恢复默认目录" Style="{StaticResource SubtleButtonStyle}" />
                                                    </StackPanel>
                                                </StackPanel>
                                                <TextBlock Grid.Row="9" Style="{StaticResource FieldLabelStyle}" Text="触发软件" />
                                                <StackPanel Grid.Row="9" Grid.Column="1" Margin="0,6,0,0">
                                                    <CheckBox IsChecked="{Binding SelectedTriggerAppFilterEnabled}" Content="只在指定软件中触发" ToolTip="开启后，搜索唤起快捷键仅在指定软件处于前台时生效；进程名不区分大小写，.exe 可省略" />
                                                    <Border Margin="0,10,0,0" Padding="10,8" Style="{StaticResource AppleInsetCardStyle}">
                                                        <StackPanel>
                                                            <Grid Margin="0,0,0,4">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="110" />
                                                                    <ColumnDefinition Width="150" />
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="56" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Grid.Column="0" Foreground="{StaticResource MutedBrush}" Text="名称" />
                                                                <TextBlock Grid.Column="1" Foreground="{StaticResource MutedBrush}" Text="进程名" />
                                                                <TextBlock Grid.Column="2" Foreground="{StaticResource MutedBrush}" Text="标题包含（可选）" />
                                                            </Grid>
                                                            <ItemsControl ItemsSource="{Binding TriggerAppRuleRows}">
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <Grid Margin="0,2">
                                                                            <Grid.ColumnDefinitions>
                                                                                <ColumnDefinition Width="110" />
                                                                                <ColumnDefinition Width="150" />
                                                                                <ColumnDefinition Width="*" />
                                                                                <ColumnDefinition Width="56" />
                                                                            </Grid.ColumnDefinitions>
                                                                            <TextBox Grid.Column="0" Margin="0,0,6,0" Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}" />
                                                                            <TextBox Grid.Column="1" Margin="0,0,6,0" Text="{Binding ProcessName, UpdateSourceTrigger=PropertyChanged}" />
                                                                            <TextBox Grid.Column="2" Margin="0,0,6,0" Text="{Binding TitleKeyword, UpdateSourceTrigger=PropertyChanged}" />
                                                                            <Button Grid.Column="3" Content="删除" Tag="{Binding}" Click="RemoveTriggerAppButton_OnClick" Style="{StaticResource SubtleButtonStyle}" />
                                                                        </Grid>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                        </StackPanel>
                                                    </Border>
                                                    <StackPanel Margin="0,10,0,0" Orientation="Horizontal">
                                                        <ComboBox Width="160" Margin="0,0,8,0" Style="{StaticResource InputComboBoxStyle}" ItemsSource="{Binding TriggerAppPresetOptions}" DisplayMemberPath="DisplayName" SelectedItem="{Binding SelectedTriggerAppPreset}" />
                                                        <Button Width="96" Margin="0,0,8,0" Click="AddPresetTriggerAppButton_OnClick" Content="添加常用" Style="{StaticResource SubtleButtonStyle}" />
                                                        <Button Width="96" Margin="0,0,8,0" Click="AddCustomTriggerAppButton_OnClick" Content="手动添加" Style="{StaticResource SubtleButtonStyle}" />
                                                        <Button Width="170" Click="PickRunningTriggerAppButton_OnClick" Content="从正在运行的软件中选择" Style="{StaticResource SubtleButtonStyle}" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                        <Border x:Name="StabilitySection" Tag="search" Style="{StaticResource SectionCardStyle}">
                                            <Grid>
                                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="140" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                                <StackPanel Grid.ColumnSpan="2" Margin="0,0,0,10"><TextBlock Style="{StaticResource SectionTitleStyle}" Text="搜索" /></StackPanel>
                                                <TextBlock Grid.Row="1" Style="{StaticResource FieldLabelStyle}" Text="默认进入模式" />
                                                <ComboBox Grid.Row="1" Grid.Column="1" Style="{StaticResource InputComboBoxStyle}" SelectedValue="{Binding SelectedDefaultSearchOverlayMode}" SelectedValuePath="Tag"><ComboBoxItem Tag="{x:Static models:SearchOverlayMode.Phrase}" Content="短语" /><ComboBoxItem Tag="{x:Static models:SearchOverlayMode.File}" Content="文件" /><ComboBoxItem Tag="{x:Static models:SearchOverlayMode.Mixed}" Content="混合搜索" /></ComboBox>
                                                <TextBlock Grid.Row="3" Style="{StaticResource FieldLabelStyle}" Text="搜索栏宽度占比" />
                                                <ComboBox Grid.Row="3" Grid.Column="1" Margin="0,4,0,0" Style="{StaticResource InputComboBoxStyle}" ItemsSource="{Binding SearchOverlayWidthPercentOptions}" SelectedItem="{Binding SelectedSearchOverlayWidthPercent}" />
                                                <TextBlock Grid.Row="4" Style="{StaticResource FieldLabelStyle}" Text="搜索栏高度占比" />
                                                <ComboBox Grid.Row="4" Grid.Column="1" Margin="0,4,0,0" Style="{StaticResource InputComboBoxStyle}" ItemsSource="{Binding SearchOverlayHeightPercentOptions}" SelectedItem="{Binding SelectedSearchOverlayHeightPercent}" />
                                                <TextBlock Grid.Row="5" Style="{StaticResource FieldLabelStyle}" Text="搜索栏透明度" />
                                                <ComboBox Grid.Row="5" Grid.Column="1" Margin="0,10,0,0" Style="{StaticResource InputComboBoxStyle}" ItemsSource="{Binding ThemeOpacityOptions}" SelectedItem="{Binding SelectedSearchOverlayOpacityPercent}" />
                                                <TextBlock Grid.Row="6" Style="{StaticResource FieldLabelStyle}" Text="输入框宽度占比" />
                                                <ComboBox Grid.Row="6" Grid.Column="1" Margin="0,4,0,0" Style="{StaticResource InputComboBoxStyle}" ItemsSource="{Binding SearchInputWidthPercentOptions}" SelectedItem="{Binding SelectedSearchInputWidthPercent}" />
                                                <TextBlock Grid.Row="7" Style="{StaticResource FieldLabelStyle}" Text="输入框高度" />
                                                <ComboBox Grid.Row="7" Grid.Column="1" Margin="0,4,0,0" Style="{StaticResource InputComboBoxStyle}" ItemsSource="{Binding SearchInputBoxHeightOptions}" SelectedItem="{Binding SelectedSearchInputBoxHeight}" />
                                                <TextBlock Grid.Row="8" Style="{StaticResource FieldLabelStyle}" Text="输入框透明度" />
                                                <ComboBox Grid.Row="8" Grid.Column="1" Margin="0,10,0,0" Style="{StaticResource InputComboBoxStyle}" ItemsSource="{Binding ThemeOpacityOptions}" SelectedItem="{Binding SelectedSearchInputOpacityPercent}" />
                                            </Grid>
                                        </Border>
                                        <Border x:Name="QuickActionsSection" Tag="quick-actions" Style="{StaticResource SectionCardStyle}">
                                            <Grid>
                                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="140" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                                <StackPanel Grid.ColumnSpan="2" Margin="0,0,0,10"><TextBlock Style="{StaticResource SectionTitleStyle}" Text="快捷发送" /></StackPanel>
                                                <TextBlock Grid.Row="1" Style="{StaticResource FieldLabelStyle}" Text="发送快捷键" />
                                                <ComboBox Grid.Row="1" Grid.Column="1" Margin="0,4,0,0" Style="{StaticResource InputComboBoxStyle}" SelectedValue="{Binding SelectedSendHotkeyMode}" SelectedValuePath="Tag"><ComboBoxItem Tag="{x:Static models:SendHotkeyMode.Enter}" Content="Enter" /><ComboBoxItem Tag="{x:Static models:SendHotkeyMode.CtrlEnter}" Content="Ctrl+Enter" /><ComboBoxItem Tag="{x:Static models:SendHotkeyMode.AltS}" Content="Alt+S" /></ComboBox>
                                                <TextBlock Grid.Row="2" Style="{StaticResource FieldLabelStyle}" Text="原文直发快捷键" />
                                                <ComboBox Grid.Row="2" Grid.Column="1" Margin="0,4,0,0" Style="{StaticResource InputComboBoxStyle}" SelectedValue="{Binding SelectedSearchTextSendShortcutMode}" SelectedValuePath="Tag" ToolTip="用于仅发送搜索输入框内容；无匹配短语时按 Enter 也会直接发送">
                                                    <ComboBoxItem Tag="{x:Static models:SearchTextSendShortcutMode.CtrlEnter}" Content="Ctrl+Enter" />
                                                    <ComboBoxItem Tag="{x:Static models:SearchTextSendShortcutMode.AltEnter}" Content="Alt+Enter" />
                                                    <ComboBoxItem Tag="{x:Static models:SearchTextSendShortcutMode.CtrlShiftEnter}" Content="Ctrl+Shift+Enter" />
                                                </ComboBox>
                                                <TextBlock Grid.Row="3" Style="{StaticResource FieldLabelStyle}" Text="图文发送顺序" />
                                                <ComboBox Grid.Row="3" Grid.Column="1" Margin="0,4,0,0" Style="{StaticResource InputComboBoxStyle}" SelectedValue="{Binding SelectedPhraseImageSendMode}" SelectedValuePath="Tag" ToolTip="抖店/飞鸽不支持图文同条发送，会自动拆分并按设定顺序分批发送；视频最后逐个提交">
                                                    <ComboBoxItem Tag="{x:Static models:PhraseImageSendMode.TextThenImageThenSend}" Content="先文字，再图片，最后发送" />
                                                    <ComboBoxItem Tag="{x:Static models:PhraseImageSendMode.ImageThenTextThenSend}" Content="先图片，再文字，最后发送" />
                                                    <ComboBoxItem Tag="{x:Static models:PhraseImageSendMode.ImageImmediateThenTextSend}" Content="图片先立即发送，再发送文字" />
                                                </ComboBox>
                                            </Grid>
                                        </Border>
                                        <Border x:Name="DelaySection" Tag="delay-control" Style="{StaticResource SectionCardStyle}">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="140" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.ColumnSpan="2" Margin="0,0,0,10">
                                                    <TextBlock Style="{StaticResource SectionTitleStyle}" Text="延迟控制" />
                                                </StackPanel>

                                                <TextBlock Grid.Row="1" Style="{StaticResource FieldLabelStyle}" Text="回到输入框延迟" />
                                                <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,4,0,0" Orientation="Horizontal">
                                                    <TextBox Width="120" MaxLength="4" Style="{StaticResource InputTextBoxStyle}" Text="{Binding SelectedRestoreFocusDelayMs, UpdateSourceTrigger=LostFocus}" PreviewTextInput="DelayTextBox_OnPreviewTextInput" DataObject.Pasting="DelayTextBox_OnPasting" LostFocus="DelayTextBox_OnLostFocus" ToolTip="搜索框关闭后，等待多久再把焦点还给目标输入框 (50-2000 ms)" />
                                                    <TextBlock Margin="10,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" Text="ms" />
                                                </StackPanel>

                                                <TextBlock Grid.Row="2" Style="{StaticResource FieldLabelStyle}" Text="激活重试间隔" />
                                                <StackPanel Grid.Row="2" Grid.Column="1" Margin="0,4,0,0" Orientation="Horizontal">
                                                    <TextBox Width="120" MaxLength="4" Style="{StaticResource InputTextBoxStyle}" Text="{Binding SelectedActivationRetryDelayMs, UpdateSourceTrigger=LostFocus}" PreviewTextInput="DelayTextBox_OnPreviewTextInput" DataObject.Pasting="DelayTextBox_OnPasting" LostFocus="DelayTextBox_OnLostFocus" ToolTip="目标窗口未切回时，后续重试之间的间隔 (50-2000 ms)" />
                                                    <TextBlock Margin="10,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" Text="ms" />
                                                </StackPanel>

                                                <TextBlock Grid.Row="3" Style="{StaticResource FieldLabelStyle}" Text="文本粘贴稳定延迟" />
                                                <StackPanel Grid.Row="3" Grid.Column="1" Margin="0,4,0,0" Orientation="Horizontal">
                                                    <TextBox Width="120" MaxLength="4" Style="{StaticResource InputTextBoxStyle}" Text="{Binding SelectedTextPasteDelayMs, UpdateSourceTrigger=LostFocus}" PreviewTextInput="DelayTextBox_OnPreviewTextInput" DataObject.Pasting="DelayTextBox_OnPasting" LostFocus="DelayTextBox_OnLostFocus" ToolTip="Ctrl+V 贴文字后，继续后续动作前的等待 (50-2000 ms)" />
                                                    <TextBlock Margin="10,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" Text="ms" />
                                                </StackPanel>

                                                <TextBlock Grid.Row="4" Style="{StaticResource FieldLabelStyle}" Text="图片粘贴稳定延迟" />
                                                <StackPanel Grid.Row="4" Grid.Column="1" Margin="0,4,0,0" Orientation="Horizontal">
                                                    <TextBox Width="120" MaxLength="4" Style="{StaticResource InputTextBoxStyle}" Text="{Binding SelectedImagePasteDelayMs, UpdateSourceTrigger=LostFocus}" PreviewTextInput="DelayTextBox_OnPreviewTextInput" DataObject.Pasting="DelayTextBox_OnPasting" LostFocus="DelayTextBox_OnLostFocus" ToolTip="贴图后，给聊天软件接收图片和生成预览的时间 (50-2000 ms)" />
                                                    <TextBlock Margin="10,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" Text="ms" />
                                                </StackPanel>

                                                <TextBlock Grid.Row="5" Style="{StaticResource FieldLabelStyle}" Text="纯文字发送前延迟" />
                                                <StackPanel Grid.Row="5" Grid.Column="1" Margin="0,4,0,0" Orientation="Horizontal">
                                                    <TextBox Width="120" MaxLength="4" Style="{StaticResource InputTextBoxStyle}" Text="{Binding SelectedSendDelayMs, UpdateSourceTrigger=LostFocus}" PreviewTextInput="DelayTextBox_OnPreviewTextInput" DataObject.Pasting="DelayTextBox_OnPasting" LostFocus="DelayTextBox_OnLostFocus" ToolTip="纯文字贴入输入框后，到按发送键之间的等待 (50-2000 ms)" />
                                                    <TextBlock Margin="10,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" Text="ms" />
                                                </StackPanel>

                                                <TextBlock Grid.Row="6" Style="{StaticResource FieldLabelStyle}" Text="图文发送前延迟" />
                                                <StackPanel Grid.Row="6" Grid.Column="1" Margin="0,4,0,0" Orientation="Horizontal">
