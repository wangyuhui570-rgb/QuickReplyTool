                                                <StackPanel Grid.Row="4" Grid.Column="1" Margin="0,6,0,0"><TextBlock Text="{Binding UserDataFolderSummary}" TextWrapping="Wrap" /><Button Width="152" Margin="0,10,0,0" HorizontalAlignment="Left" Click="OpenUserDataFolderButton_OnClick" Content="打开用户数据文件夹" Style="{StaticResource SubtleButtonStyle}" /></StackPanel>
                                                <TextBlock Grid.Row="5" Style="{StaticResource FieldLabelStyle}" Text="示例与文件库" />
                                                <StackPanel Grid.Row="5" Grid.Column="1" Margin="0,6,0,0" Orientation="Horizontal"><Button Width="152" Margin="0,0,10,0" Click="ResetPhraseDataButton_OnClick" Content="恢复默认示例短语" Style="{StaticResource SubtleButtonStyle}" /><Button Width="140" Click="ClearFileLibraryConfigurationButton_OnClick" Content="清空文件库配置" Style="{StaticResource SubtleButtonStyle}" /></StackPanel>
                                                <TextBlock Grid.Row="6" Style="{StaticResource FieldLabelStyle}" Text="恢复默认" />
                                                <StackPanel Grid.Row="6" Grid.Column="1" Margin="0,6,0,0"><Button Width="168" HorizontalAlignment="Left" Click="ResetPersonalizationButton_OnClick" Content="恢复默认个性化配置" Style="{StaticResource PrimaryButtonStyle}" ToolTip="恢复热键、外观透明度、延迟、搜索模式等默认值，保留素材路径" /></StackPanel>
                                            </Grid>
                                        </Border>
                                    </StackPanel>
                                </ScrollViewer>
                            </Border>
                        </Grid>
                    </TabItem>
                    </TabControl>
                </Grid>
            </Border>
            <Border Grid.Row="1" Margin="0,12,0,0" Padding="14" Style="{StaticResource SurfaceCardStyle}">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Foreground="{StaticResource MutedBrush}" Text="保存后会应用到当前会话。" />
                        <TextBlock Margin="0,6,0,0"
                                   Foreground="{StaticResource AppleDangerBadgeForegroundBrush}"
                                   Text="{Binding ValidationSummary}"
                                   TextWrapping="Wrap">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasValidationErrors}" Value="False">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Width="92" Margin="0,0,10,0" Click="CancelButton_OnClick" Content="取消" Style="{StaticResource SubtleButtonStyle}" />
                        <Button Width="104"
                                Click="SaveButton_OnClick"
                                Content="保存设置"
                                IsEnabled="{Binding CanSave}"
                                Style="{StaticResource PrimaryButtonStyle}" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
