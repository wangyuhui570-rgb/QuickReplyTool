<Window x:Class="QuickReply.Desktop.TagEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="添加标签"
        Width="420"
        Height="190"
        MinWidth="360"
        MinHeight="170"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        Background="Transparent"
        FontFamily="Segoe UI Variable Text">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            CornerRadius="0"
                            GlassFrameThickness="0"
                            ResizeBorderThickness="4"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <StaticResource x:Key="TitleBrush" ResourceKey="AppleTitleBrush" />
        <StaticResource x:Key="TextBrush" ResourceKey="AppleTextBrush" />
        <StaticResource x:Key="MutedBrush" ResourceKey="AppleMutedBrush" />
    </Window.Resources>

    <Border Margin="12" Style="{StaticResource AppleWindowChromeStyle}">
        <Border Style="{StaticResource AppleWindowInnerPanelStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        Style="{StaticResource AppleCompactDialogHeaderCardStyle}"
                        MouseLeftButtonDown="TitleBar_OnMouseLeftButtonDown">
                    <StackPanel>
                        <TextBlock FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TitleBrush}"
                                   Text="添加标签" />
                        <TextBlock Margin="0,4,0,0"
                                   Foreground="{StaticResource MutedBrush}"
                                   Text="多个标签可用逗号分隔，方便搜索时快速命中。"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Border Grid.Row="1"
                        Margin="0,0,0,12"
                        Style="{StaticResource AppleCompactDialogBodyCardStyle}">
                    <TextBox x:Name="TagsTextBox"
                             Style="{StaticResource AppleInputTextBoxStyle}"
                             Text="{Binding TagsText, RelativeSource={RelativeSource AncestorType=Window}, UpdateSourceTrigger=PropertyChanged}" />
                </Border>

                <Border Grid.Row="2" Style="{StaticResource AppleDialogFooterBarStyle}">
                    <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                        <Button Width="78"
                                Margin="0,0,8,0"
                                Click="CancelButton_OnClick"
                                Content="取消"
                                Style="{StaticResource AppleSecondaryButtonStyle}" />
                        <Button Width="88"
                                IsDefault="True"
                                Click="SaveButton_OnClick"
                                Content="保存标签"
                                Style="{StaticResource ApplePrimaryButtonStyle}" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Border>
</Window>
