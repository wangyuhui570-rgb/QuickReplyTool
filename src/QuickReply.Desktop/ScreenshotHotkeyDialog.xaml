<Window x:Class="QuickReply.Desktop.ScreenshotHotkeyDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="录制截图快捷键"
        Icon="pack://application:,,,/Assets/quickreply.ico"
        Width="420"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        Background="Transparent"
        FontFamily="Segoe UI Variable Text">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            CornerRadius="0"
                            GlassFrameThickness="0"
                            ResizeBorderThickness="4"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <StaticResource x:Key="TitleBrush" ResourceKey="AppleTitleBrush" />
        <StaticResource x:Key="TextBrush" ResourceKey="AppleTextBrush" />
        <StaticResource x:Key="MutedBrush" ResourceKey="AppleMutedBrush" />
    </Window.Resources>

    <Border Margin="12" Style="{StaticResource AppleWindowChromeStyle}">
        <Border Style="{StaticResource AppleWindowInnerPanelStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="2,0,2,14" MouseLeftButtonDown="TitleBar_OnMouseLeftButtonDown">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock VerticalAlignment="Center"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TitleBrush}"
                               Text="录制截图快捷键" />
                    <Button Grid.Column="1"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Click="CancelButton_OnClick"
                            Style="{StaticResource AppleWindowCloseButtonStyle}" />
                </Grid>

                <Grid Grid.Row="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="70" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" Text="当前键位" />
                    <Border Grid.Column="1" Padding="12,8" Background="{DynamicResource AppleCardSurfaceBrush}" BorderBrush="{DynamicResource AppleCardBorderBrush}" BorderThickness="1" CornerRadius="8">
                        <TextBlock x:Name="CurrentHotkeyTextBlock" FontSize="13" Foreground="{StaticResource TitleBrush}" />
                    </Border>

                    <TextBlock Grid.Row="1" VerticalAlignment="Center" Margin="0,10,0,0" Foreground="{StaticResource MutedBrush}" Text="新快捷键" />
                    <Border x:Name="CaptureSurface"
                            Grid.Row="1"
                            Grid.Column="1"
                            Margin="0,10,0,0"
                            Padding="12,12"
                            Background="{DynamicResource AppleCardSurfaceBrush}"
                            BorderBrush="{StaticResource AppleAccentBrush}"
                            BorderThickness="1.5"
                            CornerRadius="8"
                            Focusable="True"
                            PreviewKeyDown="CaptureSurface_OnPreviewKeyDown"
                            MouseLeftButtonDown="CaptureSurface_OnMouseLeftButtonDown">
                        <TextBlock x:Name="CapturedHotkeyTextBlock" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TitleBrush}" Text="请按下新的快捷键" />
                    </Border>

                    <TextBlock x:Name="ErrorTextBlock"
                               Grid.Row="2"
                               Grid.Column="1"
                               Margin="0,8,0,0"
                               Foreground="{DynamicResource AppleWarningBrush}"
                               TextWrapping="Wrap" />
                </Grid>

                <DockPanel Grid.Row="2" Margin="0,16,0,0" LastChildFill="False">
                    <Button DockPanel.Dock="Left"
                            Width="88"
                            Height="32"
                            Click="RestoreDefaultButton_OnClick"
                            Content="恢复默认"
                            Style="{StaticResource AppleSecondaryButtonStyle}" />
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Width="72"
                                Height="32"
                                Margin="0,0,8,0"
                                Click="CancelButton_OnClick"
                                Content="取消"
                                Style="{StaticResource AppleSecondaryButtonStyle}" />
                        <Button x:Name="SaveButton"
                                Width="72"
                                Height="32"
                                Click="SaveButton_OnClick"
                                Content="保存"
                                IsEnabled="False"
                                Style="{StaticResource ApplePrimaryButtonStyle}" />
                    </StackPanel>
                </DockPanel>
            </Grid>
        </Border>
    </Border>
</Window>
