<Window x:Class="QuickReply.Desktop.ScreenshotHotkeyDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="录制截图快捷键"
        Icon="pack://application:,,,/Assets/quickreply.ico"
        Width="440"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#FFF8FAFC">
    <Border Padding="22">
        <StackPanel>
            <TextBlock FontSize="18" FontWeight="SemiBold" Foreground="#0F172A" Text="录制截图快捷键" />
            <TextBlock Margin="0,8,0,0" Foreground="#475569" Text="点击下方区域后直接按下新的快捷键组合。至少包含一个修饰键，支持字母、数字、F1-F24、Space、Tab、Esc、Enter。" TextWrapping="Wrap" />

            <Grid Margin="0,18,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="84" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBlock VerticalAlignment="Center" Foreground="#64748B" Text="当前值" />
                <Border Grid.Column="1" Padding="12,10" Background="#FFFFFFFF" BorderBrush="#D6DEE8" BorderThickness="1" CornerRadius="10">
                    <TextBlock x:Name="CurrentHotkeyTextBlock" FontSize="14" Foreground="#0F172A" />
                </Border>

                <TextBlock Grid.Row="1" VerticalAlignment="Center" Margin="0,14,0,0" Foreground="#64748B" Text="新快捷键" />
                <Border x:Name="CaptureSurface"
                        Grid.Row="1"
                        Grid.Column="1"
                        Margin="0,14,0,0"
                        Padding="12,14"
                        Background="#FFFFFFFF"
                        BorderBrush="#60A5FA"
                        BorderThickness="1.5"
                        CornerRadius="12"
                        Focusable="True"
                        PreviewKeyDown="CaptureSurface_OnPreviewKeyDown"
                        MouseLeftButtonDown="CaptureSurface_OnMouseLeftButtonDown">
                    <StackPanel>
                        <TextBlock x:Name="CapturedHotkeyTextBlock" FontSize="17" FontWeight="SemiBold" Foreground="#0F172A" Text="请按下新的快捷键" />
                        <TextBlock Margin="0,6,0,0" Foreground="#64748B" Text="按 Esc 可取消；点“恢复默认”会直接改回 Alt+A。" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <TextBlock x:Name="ErrorTextBlock"
                           Grid.Row="2"
                           Grid.Column="1"
                           Margin="0,10,0,0"
                           Foreground="#DC2626"
                           TextWrapping="Wrap" />
            </Grid>

            <StackPanel Margin="0,22,0,0" HorizontalAlignment="Right" Orientation="Horizontal">
                <Button Width="96" Margin="0,0,8,0" Click="RestoreDefaultButton_OnClick" Content="恢复默认" />
                <Button Width="88" Margin="0,0,8,0" Click="CancelButton_OnClick" Content="取消" />
                <Button x:Name="SaveButton" Width="88" Click="SaveButton_OnClick" Content="保存" IsEnabled="False" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
