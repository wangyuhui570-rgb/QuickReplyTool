<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>QuickReplyTool</AssemblyName>
    <ApplicationIcon>Assets\quickreply.ico</ApplicationIcon>
    <Version>2.1.12</Version>
    <AssemblyVersion>2.1.12.0</AssemblyVersion>
    <FileVersion>2.1.12.0</FileVersion>
    <InformationalVersion>2.1.12</InformationalVersion>
    <Title>客服效率工具$(Version)</Title>
    <AssemblyTitle>客服效率工具$(Version)</AssemblyTitle>
    <Product>客服效率工具$(Version)</Product>
    <Description>客服效率工具$(Version)</Description>
    <StartupObject>QuickReply.Desktop.App</StartupObject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.0" />
    <PackageReference Include="NPOI" Version="2.7.6" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\QuickReply.Core\QuickReply.Core.csproj" />
  </ItemGroup>


  <ItemGroup>
    <Resource Include="Assets\quickreply.ico" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\截图工具源码\lite_shot.py" Link="ScreenshotTool\lite_shot.py">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
  </ItemGroup>

</Project>
