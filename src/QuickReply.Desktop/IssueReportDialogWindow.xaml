<Window x:Class="QuickReply.Desktop.IssueReportDialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="问题记录"
        Width="540"
        Height="420"
        MinWidth="460"
        MinHeight="360"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="None"
        Background="Transparent"
        FontFamily="Segoe UI Variable Text">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            CornerRadius="0"
                            GlassFrameThickness="0"
                            ResizeBorderThickness="4"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <StaticResource x:Key="TitleBrush" ResourceKey="AppleTitleBrush" />
        <StaticResource x:Key="TextBrush" ResourceKey="AppleTextBrush" />
        <StaticResource x:Key="MutedBrush" ResourceKey="AppleMutedBrush" />
    </Window.Resources>

    <Border Margin="12" Style="{StaticResource AppleWindowChromeStyle}">
        <Border Style="{StaticResource AppleWindowInnerPanelStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="2,0,2,10" MouseLeftButtonDown="TitleBar_OnMouseLeftButtonDown">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock VerticalAlignment="Center"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TitleBrush}"
                               Text="记录问题反馈" />
                    <Button Grid.Column="1"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Click="CloseButton_OnClick"
                            ToolTip="关闭"
                            Style="{StaticResource AppleWindowCloseButtonStyle}" />
                </Grid>

                <Border Grid.Row="1"
                        Style="{StaticResource AppleCompactDialogBodyCardStyle}">
                    <Grid>
                        <TextBox x:Name="IssueTextBox"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 FontSize="13"
                                 Foreground="{DynamicResource AppleTextBrush}"
                                 CaretBrush="{DynamicResource AppleAccentBrush}" />
                        <TextBlock Text="请详细描述你遇到的异常现象或操作步骤...&#x0a;提交后会在本地生成诊断数据包供排查"
                                   Margin="2,2,0,0" VerticalAlignment="Top" IsHitTestVisible="False"
                                   FontSize="13" LineHeight="20" Foreground="{DynamicResource MutedBrush}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=IssueTextBox}" Value="">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </Border>

                <Border Grid.Row="2"
                        Style="{StaticResource AppleDialogFooterBarStyle}">
                    <Grid>
                        <TextBlock VerticalAlignment="Center" FontSize="12"
                                   Foreground="{StaticResource MutedBrush}"
                                   Text="将自动附带最近运行日志与设置快照" />
                        <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                            <Button Width="84"
                                    Margin="0,0,8,0"
                                    Click="CloseButton_OnClick"
                                    Content="取消"
                                    Style="{StaticResource AppleSecondaryButtonStyle}" />
                            <Button x:Name="SubmitButton"
                                    MinWidth="110"
                                    Click="SubmitButton_OnClick"
                                    Content="生成并反馈"
                                    Style="{StaticResource ApplePrimaryButtonStyle}" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Border>
</Window>