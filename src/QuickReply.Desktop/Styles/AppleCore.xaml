<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="AppleWindowBackgroundBrush" Color="#F5F5F7" />
    <SolidColorBrush x:Key="AppleSurfaceBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="AppleSurfaceAltBrush" Color="#FAFAFC" />
    <SolidColorBrush x:Key="AppleLineBrush" Color="#D2D2D7" />
    <SolidColorBrush x:Key="AppleStrongLineBrush" Color="#B8B8BE" />
    <SolidColorBrush x:Key="AppleAccentBrush" Color="#0071E3" />
    <SolidColorBrush x:Key="AppleAccentHoverBrush" Color="#0077ED" />
    <SolidColorBrush x:Key="AppleAccentPressedBrush" Color="#005FBE" />
    <SolidColorBrush x:Key="AppleAccentSoftBrush" Color="#E8F1FB" />
    <SolidColorBrush x:Key="AppleAccentSoftBorderBrush" Color="#A9C9EF" />
    <SolidColorBrush x:Key="AppleTitleBrush" Color="#1D1D1F" />
    <SolidColorBrush x:Key="AppleTextBrush" Color="#3A3A3C" />
    <SolidColorBrush x:Key="AppleMutedBrush" Color="#6E6E73" />
    <SolidColorBrush x:Key="AppleSubtleMutedBrush" Color="#8E8E93" />
    <SolidColorBrush x:Key="AppleSuccessBrush" Color="#148564" />
    <SolidColorBrush x:Key="AppleSelectionHoverBrush" Color="#F6F8FC" />
    <SolidColorBrush x:Key="AppleSelectionActiveBrush" Color="#EEF5FD" />
    <SolidColorBrush x:Key="AppleProgressTrackBrush" Color="#E7E7EC" />
    <SolidColorBrush x:Key="AppleTooltipBackgroundBrush" Color="#FDFDFE" />
    <SolidColorBrush x:Key="AppleTooltipBorderBrush" Color="#D2D2D7" />
    <SolidColorBrush x:Key="AppleSecondaryButtonBackgroundBrush" Color="#FDFDFE" />
    <SolidColorBrush x:Key="AppleSecondaryButtonBorderBrush" Color="#D2D2D7" />
    <SolidColorBrush x:Key="AppleSecondaryButtonForegroundBrush" Color="#1D1D1F" />
    <SolidColorBrush x:Key="AppleSecondaryButtonHoverBackgroundBrush" Color="#F5F5F7" />
    <SolidColorBrush x:Key="AppleSecondaryButtonHoverBorderBrush" Color="#B8B8BE" />
    <SolidColorBrush x:Key="ApplePrimaryButtonForegroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="AppleTabSelectedBackgroundBrush" Color="#E8F1FB" />
    <SolidColorBrush x:Key="AppleTabSelectedBorderBrush" Color="#A9C9EF" />
    <SolidColorBrush x:Key="AppleTabHoverBackgroundBrush" Color="#F2F2F5" />
    <SolidColorBrush x:Key="AppleBadgeBackgroundBrush" Color="#E8F1FB" />
    <SolidColorBrush x:Key="AppleBadgeBorderBrush" Color="#A9C9EF" />
    <SolidColorBrush x:Key="AppleBadgeForegroundBrush" Color="#0071E3" />
    <SolidColorBrush x:Key="AppleInfoCardBackgroundBrush" Color="#F7FAFE" />
    <SolidColorBrush x:Key="AppleInfoCardBorderBrush" Color="#DCE4F2" />
    <SolidColorBrush x:Key="AppleInsetCardBorderBrush" Color="#DDDDE3" />
    <SolidColorBrush x:Key="AppleDangerBadgeBackgroundBrush" Color="#FDEEEE" />
    <SolidColorBrush x:Key="AppleDangerBadgeBorderBrush" Color="#F3B8B5" />
    <SolidColorBrush x:Key="AppleDangerBadgeForegroundBrush" Color="#C9342C" />
    <SolidColorBrush x:Key="AppleMenuBackgroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="AppleMenuBorderBrush" Color="#D2D2D7" />
    <SolidColorBrush x:Key="AppleMenuForegroundBrush" Color="#1D1D1F" />
    <SolidColorBrush x:Key="AppleMenuMutedBrush" Color="#6E6E73" />
    <SolidColorBrush x:Key="AppleMenuHoverBackgroundBrush" Color="#F2F7FD" />
    <SolidColorBrush x:Key="AppleMenuHoverBorderBrush" Color="#C3D7F2" />
    <SolidColorBrush x:Key="AppleMenuSeparatorBrush" Color="#E2E6EC" />

    <SolidColorBrush x:Key="Menu.Static.Background" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Menu.Static.Border" Color="#D2D2D7" />
    <SolidColorBrush x:Key="Menu.Static.Foreground" Color="#1D1D1F" />
    <SolidColorBrush x:Key="MenuItem.Highlight.Background" Color="#F2F7FD" />
    <SolidColorBrush x:Key="MenuItem.Highlight.Border" Color="#C3D7F2" />
    <SolidColorBrush x:Key="MenuItem.Selected.Background" Color="#F2F7FD" />
    <SolidColorBrush x:Key="MenuItem.Selected.Border" Color="#C3D7F2" />
    <SolidColorBrush x:Key="MenuItem.Highlight.Disabled.Background" Color="#F5F5F7" />
    <SolidColorBrush x:Key="MenuItem.Highlight.Disabled.Border" Color="#D2D2D7" />
    <SolidColorBrush x:Key="MenuItem.Disabled.Foreground" Color="#8E8E93" />
    <SolidColorBrush x:Key="MenuItem.Separator.Fill" Color="#E2E6EC" />
    <SolidColorBrush x:Key="MenuItem.Separator.Stroke" Color="#E2E6EC" />
    <SolidColorBrush x:Key="Menu.Popup.Background" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Menu.Popup.Border" Color="#D2D2D7" />

    <DropShadowEffect x:Key="AppleFloatingShadowEffect"
                      BlurRadius="30"
                      ShadowDepth="0"
                      Color="#2E000000"
                      Opacity="0.18" />

    <Style TargetType="ToolTip">
        <Setter Property="Background" Value="{DynamicResource AppleTooltipBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AppleTooltipBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{DynamicResource AppleMenuForegroundBrush}" />
        <Setter Property="Padding" Value="12,10" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="HasDropShadow" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border x:Name="ToolTipSurface"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="14"
                            Opacity="0"
                            RenderTransformOrigin="0.5,0.12"
                            Effect="{StaticResource AppleFloatingShadowEffect}">
                        <Border.RenderTransform>
                            <ScaleTransform ScaleX="0.985" ScaleY="0.985" />
                        </Border.RenderTransform>
                        <ContentPresenter Margin="{TemplateBinding Padding}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsOpen" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="ToolTipSurface"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="1"
                                                         Duration="0:0:0.18">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="ToolTipSurface"
                                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                         To="1"
                                                         Duration="0:0:0.18">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="ToolTipSurface"
                                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                         To="1"
                                                         Duration="0:0:0.18">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ContextMenu">
        <Setter Property="Background" Value="{DynamicResource AppleMenuBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AppleMenuBorderBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource AppleMenuForegroundBrush}" />
        <Setter Property="Padding" Value="6" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                    <Border x:Name="ContextMenuSurface"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="16"
                            Opacity="0"
                            RenderTransformOrigin="0.5,0.08"
                            Effect="{StaticResource AppleFloatingShadowEffect}">
                        <Border.RenderTransform>
                            <ScaleTransform ScaleX="0.985" ScaleY="0.985" />
                        </Border.RenderTransform>
                        <StackPanel IsItemsHost="True"
                                    KeyboardNavigation.DirectionalNavigation="Cycle" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsOpen" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="ContextMenuSurface"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="1"
                                                         Duration="0:0:0.18">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="ContextMenuSurface"
                                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                         To="1"
                                                         Duration="0:0:0.18">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="ContextMenuSurface"
                                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                         To="1"
                                                         Duration="0:0:0.18">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="MenuItem">
        <Setter Property="Foreground" Value="{DynamicResource AppleMenuForegroundBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="Margin" Value="4,2" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style TargetType="Separator">
        <Setter Property="Margin" Value="8,5" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Separator">
                    <Border Height="1"
                            Background="{DynamicResource AppleMenuSeparatorBrush}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="AppleSecondaryButtonStyle" TargetType="Button">
        <Setter Property="Height" Value="36" />
        <Setter Property="MinWidth" Value="76" />
        <Setter Property="Padding" Value="14,0" />
        <Setter Property="Background" Value="{DynamicResource AppleSecondaryButtonBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AppleSecondaryButtonBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{DynamicResource AppleSecondaryButtonForegroundBrush}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="ButtonBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="12">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource AppleSecondaryButtonHoverBackgroundBrush}" />
                            <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{DynamicResource AppleSecondaryButtonHoverBorderBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.9" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.48" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ApplePrimaryButtonStyle"
           TargetType="Button"
           BasedOn="{StaticResource AppleSecondaryButtonStyle}">
        <Setter Property="Background" Value="{DynamicResource AppleAccentBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AppleAccentBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource ApplePrimaryButtonForegroundBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="ButtonBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="12">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource AppleAccentHoverBrush}" />
                            <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{DynamicResource AppleAccentHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource AppleAccentPressedBrush}" />
                            <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{DynamicResource AppleAccentPressedBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.48" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="AppleCompactButtonStyle"
           TargetType="Button"
           BasedOn="{StaticResource AppleSecondaryButtonStyle}">
        <Setter Property="Height" Value="30" />
        <Setter Property="MinWidth" Value="60" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="FontSize" Value="12" />
    </Style>

    <Style x:Key="AppleCompactPrimaryButtonStyle"
           TargetType="Button"
           BasedOn="{StaticResource ApplePrimaryButtonStyle}">
        <Setter Property="Height" Value="30" />
        <Setter Property="MinWidth" Value="60" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="FontSize" Value="12" />
    </Style>

    <Style x:Key="AppleFloatingTextBoxStyle" TargetType="TextBox">
        <Setter Property="Height" Value="38" />
        <Setter Property="Padding" Value="12,4" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Background" Value="{DynamicResource SearchInputBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource SearchInputBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{DynamicResource SearchInputForegroundBrush}" />
        <Setter Property="CaretBrush" Value="{DynamicResource AppleAccentBrush}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource AppleSelectionActiveBrush}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="InputBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="14">
                        <ScrollViewer x:Name="PART_ContentHost"
                                      Margin="{TemplateBinding Padding}"
                                      TextElement.Foreground="{TemplateBinding Foreground}"
                                      VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="InputBorder" Property="BorderBrush" Value="{DynamicResource AppleAccentBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="InputBorder" Property="Opacity" Value="0.55" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="AppleInputTextBoxStyle"
           TargetType="TextBox"
           BasedOn="{StaticResource AppleFloatingTextBoxStyle}">
        <Setter Property="Height" Value="40" />
        <Setter Property="Background" Value="{DynamicResource AppleSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AppleStrongLineBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource AppleTitleBrush}" />
    </Style>

    <Style x:Key="AppleInputComboBoxItemStyle" TargetType="ComboBoxItem">
        <Setter Property="Foreground" Value="{DynamicResource AppleTitleBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Padding" Value="12,9" />
        <Setter Property="Margin" Value="2" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="ItemBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="12"
                            SnapsToDevicePixels="True">
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource AppleSelectionHoverBrush}" />
                            <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{DynamicResource AppleAccentSoftBorderBrush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource AppleSelectionActiveBrush}" />
                            <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{DynamicResource AppleAccentSoftBorderBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource AppleAccentBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="ItemBorder" Property="Opacity" Value="0.46" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="AppleInputComboBoxStyle" TargetType="ComboBox">
        <Setter Property="Height" Value="40" />
        <Setter Property="Padding" Value="14,0,42,0" />
        <Setter Property="Background" Value="{DynamicResource AppleSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AppleStrongLineBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{DynamicResource AppleTitleBrush}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource AppleInputComboBoxItemStyle}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid x:Name="Root" SnapsToDevicePixels="True">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="34" />
                                </Grid.ColumnDefinitions>
                                <ContentPresenter Margin="{TemplateBinding Padding}"
                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                  Content="{TemplateBinding SelectionBoxItem}"
                                                  ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                                  ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                  IsHitTestVisible="False" />
                                <Border Grid.Column="1"
                                        Margin="0,6,6,6"
                                        Background="{DynamicResource AppleSelectionHoverBrush}"
                                        CornerRadius="10"
                                        IsHitTestVisible="False">
                                    <Path Width="10"
                                          Height="6"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Data="M 0 0 L 5 5 L 10 0"
                                          Stroke="{DynamicResource AppleMutedBrush}"
                                          StrokeThickness="1.5"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round" />
                                </Border>
                            </Grid>
                        </Border>
                        <ToggleButton Focusable="False"
                                      Background="Transparent"
                                      BorderThickness="0"
                                      ClickMode="Press"
                                      IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border Background="Transparent"
                                            CornerRadius="14" />
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <Popup x:Name="PART_Popup"
                               AllowsTransparency="True"
                               Focusable="False"
                               IsOpen="{TemplateBinding IsDropDownOpen}"
                               Placement="Bottom"
                               PopupAnimation="Fade">
                            <Grid MinWidth="{Binding ActualWidth, ElementName=Root}"
                                  MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                <Border Margin="0,6,0,0"
                                        Padding="6"
                                        Background="{DynamicResource AppleSurfaceBrush}"
                                        BorderBrush="{DynamicResource AppleLineBrush}"
                                        BorderThickness="1"
                                        CornerRadius="16"
                                        Effect="{StaticResource AppleFloatingShadowEffect}">
                                    <ScrollViewer CanContentScroll="True"
                                                  HorizontalScrollBarVisibility="Disabled"
                                                  VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                                    </ScrollViewer>
                                </Border>
                            </Grid>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource AppleSelectionHoverBrush}" />
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource AppleAccentSoftBorderBrush}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource AppleAccentBrush}" />
                        </Trigger>
                        <Trigger Property="IsDropDownOpen" Value="True">
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource AppleAccentBrush}" />
                        </Trigger>
                        <Trigger Property="HasItems" Value="False">
                            <Setter Property="MinHeight" Value="40" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Chrome" Property="Opacity" Value="0.52" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="AppleWindowChromeStyle" TargetType="Border">
        <Setter Property="Margin" Value="12" />
        <Setter Property="Padding" Value="16" />
        <Setter Property="Background" Value="{DynamicResource AppleWindowBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AppleLineBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="24" />
        <Setter Property="Effect" Value="{StaticResource AppleFloatingShadowEffect}" />
    </Style>

    <Style x:Key="AppleWindowInnerPanelStyle" TargetType="Border">
        <Setter Property="Padding" Value="14" />
        <Setter Property="Background" Value="{DynamicResource AppleSurfaceAltBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AppleLineBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="20" />
    </Style>

    <Style x:Key="AppleSurfaceCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource AppleSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AppleLineBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="18" />
    </Style>

    <Style x:Key="AppleSectionCardStyle" TargetType="Border">
        <Setter Property="Padding" Value="18" />
        <Setter Property="Margin" Value="0,0,0,14" />
        <Setter Property="Background" Value="{DynamicResource AppleSurfaceAltBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AppleLineBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="16" />
    </Style>

    <Style x:Key="AppleSectionTitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="17" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource AppleTitleBrush}" />
    </Style>

    <Style x:Key="AppleFieldLabelStyle" TargetType="TextBlock">
        <Setter Property="Margin" Value="0,10,14,0" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="Foreground" Value="{DynamicResource AppleTextBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="AppleNavButtonStyle"
           TargetType="Button"
           BasedOn="{StaticResource AppleSecondaryButtonStyle}">
        <Setter Property="Height" Value="40" />
        <Setter Property="Margin" Value="0,0,0,8" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource AppleTextBrush}" />
    </Style>

    <Style x:Key="AppleTabControlStyle" TargetType="TabControl">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabControl">
                    <Grid KeyboardNavigation.TabNavigation="Local">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0"
                                Padding="6"
                                Background="{DynamicResource AppleSurfaceBrush}"
                                BorderBrush="{DynamicResource AppleLineBrush}"
                                BorderThickness="1"
                                CornerRadius="18">
                            <TabPanel x:Name="HeaderPanel"
                                      IsItemsHost="True"
                                      Background="Transparent" />
                        </Border>
                        <ContentPresenter Grid.Row="1"
                                          Margin="0,12,0,0"
                                          ContentSource="SelectedContent" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

