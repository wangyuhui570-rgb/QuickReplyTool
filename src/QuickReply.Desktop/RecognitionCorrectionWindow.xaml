<Window x:Class="QuickReply.Desktop.RecognitionCorrectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="修正识别"
        Width="680"
        Height="560"
        MinWidth="560"
        MinHeight="440"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ResizeMode="CanResizeWithGrip">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Margin="0,0,0,12"
                   FontSize="13"
                   Foreground="{DynamicResource SearchOverlayMutedBrush}"
                   Text="可同时修正客户问题、上下文、商品信息和消息序列。消息序列按每行一条填写。" />

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock FontSize="12"
                           FontWeight="SemiBold"
                           Text="客户问题" />
                <TextBox x:Name="CustomerTextBox"
                         Margin="0,6,0,12"
                         MinHeight="72"
                         Padding="10,8"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto" />

                <TextBlock FontSize="12"
                           FontWeight="SemiBold"
                           Text="上下文" />
                <TextBox x:Name="ContextTextBox"
                         Margin="0,6,0,12"
                         MinHeight="72"
                         Padding="10,8"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto" />

                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock FontSize="12"
                                   FontWeight="SemiBold"
                                   Text="商品 ID" />
                        <TextBox x:Name="ProductIdTextBox"
                                 Margin="0,6,0,0"
                                 Padding="10,8" />
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock FontSize="12"
                                   FontWeight="SemiBold"
                                   Text="商品名称" />
                        <TextBox x:Name="ProductNameTextBox"
                                 Margin="0,6,0,0"
                                 Padding="10,8" />
                    </StackPanel>
                </Grid>

                <TextBlock FontSize="12"
                           FontWeight="SemiBold"
                           Text="消息序列（每行一条）" />
                <TextBox x:Name="MessagesTextBox"
                         Margin="0,6,0,0"
                         MinHeight="150"
                         Padding="10,8"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto" />
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2"
                    Margin="0,14,0,0"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal">
            <Button MinWidth="88"
                    Margin="0,0,8,0"
                    Click="SaveButton_OnClick"
                    Content="保存"
                    Style="{StaticResource AppleCompactPrimaryButtonStyle}" />
            <Button MinWidth="88"
                    Click="CancelButton_OnClick"
                    Content="取消"
                    Style="{StaticResource AppleCompactButtonStyle}" />
        </StackPanel>
    </Grid>
</Window>
