<Window x:Class="QuickReply.Desktop.FirstRunGuideWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:QuickReply.Desktop.Models"
        Title="首次设置"
        Icon="pack://application:,,,/Assets/quickreply.ico"
        Width="620"
        Height="500"
        MinWidth="620"
        MinHeight="500"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="Transparent"
        FontFamily="Segoe UI Variable Text"
        AllowsTransparency="True"
        WindowStyle="None">
    <Window.Resources>
        <StaticResource x:Key="WindowBackgroundBrush" ResourceKey="AppleWindowBackgroundBrush" />
        <StaticResource x:Key="SurfaceBrush" ResourceKey="AppleSurfaceBrush" />
        <StaticResource x:Key="SurfaceAltBrush" ResourceKey="AppleSurfaceAltBrush" />
        <StaticResource x:Key="LineBrush" ResourceKey="AppleLineBrush" />
        <StaticResource x:Key="StrongLineBrush" ResourceKey="AppleStrongLineBrush" />
        <StaticResource x:Key="AccentBrush" ResourceKey="AppleAccentBrush" />
        <StaticResource x:Key="TitleBrush" ResourceKey="AppleTitleBrush" />
        <StaticResource x:Key="TextBrush" ResourceKey="AppleTextBrush" />
        <StaticResource x:Key="MutedBrush" ResourceKey="AppleMutedBrush" />
        <StaticResource x:Key="CardShadowEffect" ResourceKey="AppleFloatingShadowEffect" />
        <Style x:Key="SubtleButtonStyle" TargetType="Button" BasedOn="{StaticResource AppleSecondaryButtonStyle}" />
        <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource ApplePrimaryButtonStyle}" />
        <Style x:Key="InputComboBoxStyle" TargetType="ComboBox" BasedOn="{StaticResource AppleInputComboBoxStyle}" />
        <Style x:Key="InputTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource AppleInputTextBoxStyle}" />
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </Window.Resources>
    <Border Style="{StaticResource AppleWindowChromeStyle}"
            Padding="18"
            MouseLeftButtonDown="TitleBar_OnMouseLeftButtonDown">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock FontSize="28" FontWeight="Bold" Foreground="{StaticResource TitleBrush}" Text="首次设置" />
                    <TextBlock Margin="0,8,0,0"
                               Foreground="{StaticResource MutedBrush}"
                               Text="先把最关键的 3 项设置好：搜索唤起、发送键、文件资料目录。后面在选项里还可以继续细调。"
                               TextWrapping="Wrap" />
                </StackPanel>
                <Button Grid.Column="1"
                        Width="34"
                        Height="34"
                        Click="SkipButton_OnClick"
                        Content="×"
                        FontSize="18"
                        Style="{StaticResource SubtleButtonStyle}" />
            </Grid>

            <Border Grid.Row="1"
                    Margin="0,18,0,18"
                    Padding="20"
                    Style="{StaticResource AppleWindowInnerPanelStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal">
                        <Border Style="{StaticResource AppleStepBadgeStyle}">
                            <TextBlock Style="{StaticResource AppleStepBadgeTextStyle}" Text="1" />
                        </Border>
                        <Border Width="44" Height="4" Margin="10,13,10,0" VerticalAlignment="Top" Background="{Binding StepDividerBrush1}" CornerRadius="2" />
                        <Border Style="{StaticResource AppleStepBadgeStyle}" Background="{Binding StepBadgeBrush2}">
                            <TextBlock Style="{StaticResource AppleStepBadgeTextStyle}" Foreground="{Binding StepBadgeTextBrush2}" Text="2" />
                        </Border>
                        <Border Width="44" Height="4" Margin="10,13,10,0" VerticalAlignment="Top" Background="{Binding StepDividerBrush2}" CornerRadius="2" />
                        <Border Style="{StaticResource AppleStepBadgeStyle}" Background="{Binding StepBadgeBrush3}">
                            <TextBlock Style="{StaticResource AppleStepBadgeTextStyle}" Foreground="{Binding StepBadgeTextBrush3}" Text="3" />
                        </Border>
                    </StackPanel>

                    <Grid Grid.Row="1">
                        <Grid.Resources>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </Style>
                        </Grid.Resources>

                        <StackPanel x:Name="StepOnePanel" Margin="0,20,0,0">
                            <TextBlock FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource TitleBrush}" Text="步骤 1：搜索唤起热键" />
                            <TextBlock Margin="0,8,0,0" Foreground="{StaticResource MutedBrush}" Text="建议先选一个自己最顺手的搜索唤起方式。" TextWrapping="Wrap" />
                            <StackPanel Margin="0,20,0,0">
                                <TextBlock Margin="0,0,0,8" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" Text="搜索唤起" />
                                <ComboBox Style="{StaticResource InputComboBoxStyle}" SelectedValue="{Binding SelectedSearchHotkeyMode}" SelectedValuePath="Tag">
                                    <ComboBoxItem Tag="{x:Static models:SearchFocusHotkeyMode.Tab}" Content="Tab" />
                                    <ComboBoxItem Tag="{x:Static models:SearchFocusHotkeyMode.DoubleCtrl}" Content="双击 Ctrl" />
                                    <ComboBoxItem Tag="{x:Static models:SearchFocusHotkeyMode.AltQ}" Content="Alt+Q" />
                                </ComboBox>
                            </StackPanel>
                        </StackPanel>

                        <StackPanel x:Name="StepTwoPanel" Margin="0,20,0,0">
                            <TextBlock FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource TitleBrush}" Text="步骤 2：发送快捷键" />
                            <TextBlock Margin="0,8,0,0" Foreground="{StaticResource MutedBrush}" Text="按你当前客服工作台的习惯，先把发送键确认好。" TextWrapping="Wrap" />
                            <StackPanel Margin="0,20,0,0">
                                <TextBlock Margin="0,0,0,8" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" Text="发送快捷键" />
                                <ComboBox Style="{StaticResource InputComboBoxStyle}" SelectedValue="{Binding SelectedSendHotkeyMode}" SelectedValuePath="Tag">
                                    <ComboBoxItem Tag="{x:Static models:SendHotkeyMode.Enter}" Content="Enter" />
                                    <ComboBoxItem Tag="{x:Static models:SendHotkeyMode.CtrlEnter}" Content="Ctrl+Enter" />
                                    <ComboBoxItem Tag="{x:Static models:SendHotkeyMode.AltS}" Content="Alt+S" />
                                </ComboBox>
                            </StackPanel>
                        </StackPanel>

                        <StackPanel x:Name="StepThreePanel" Margin="0,20,0,0">
                            <TextBlock FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource TitleBrush}" Text="步骤 3：文件资料目录" />
                            <TextBlock Margin="0,8,0,0" Foreground="{StaticResource MutedBrush}" Text="把常用安装包、图片、视频放进一个资料文件夹，后面就能直接在搜索栏里搜文件名发送。" TextWrapping="Wrap" />
                            <StackPanel Margin="0,20,0,0">
                                <TextBlock Margin="0,0,0,8" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" Text="资料文件夹" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Style="{StaticResource InputTextBoxStyle}" Text="{Binding SelectedFileLibraryFolderPath}" />
                                    <Button Grid.Column="1"
                                            Margin="10,0,0,0"
                                            Width="104"
                                            Click="BrowseFolderButton_OnClick"
                                            Content="选择文件夹"
                                            Style="{StaticResource SubtleButtonStyle}" />
                                </Grid>
                                <TextBlock Margin="0,8,0,0"
                                           Foreground="{Binding FileLibraryFolderHelperBrush}"
                                           Text="{Binding FileLibraryFolderHelperText}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button Width="108"
                        Click="BackButton_OnClick"
                        Content="上一步"
                        IsEnabled="{Binding CanGoBack}"
                        Style="{StaticResource SubtleButtonStyle}" />
                <Button Grid.Column="2"
                        Width="126"
                        Click="NextButton_OnClick"
                        Content="{Binding NextButtonText}"
                        IsEnabled="{Binding CanMoveNext}"
                        Style="{StaticResource PrimaryButtonStyle}" />
            </Grid>
        </Grid>
    </Border>
</Window>
