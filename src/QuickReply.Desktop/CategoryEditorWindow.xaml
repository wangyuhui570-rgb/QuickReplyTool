<Window x:Class="QuickReply.Desktop.CategoryEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="分类"
        Width="360"
        Height="150"
        MinWidth="320"
        MinHeight="140"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        Background="Transparent"
        FontFamily="Segoe UI Variable Text">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            CornerRadius="0"
                            GlassFrameThickness="0"
                            ResizeBorderThickness="4"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <StaticResource x:Key="TitleBrush" ResourceKey="AppleTitleBrush" />
        <StaticResource x:Key="TextBrush" ResourceKey="AppleTextBrush" />
        <StaticResource x:Key="MutedBrush" ResourceKey="AppleMutedBrush" />
    </Window.Resources>

    <Border Margin="12" Style="{StaticResource AppleWindowChromeStyle}">
        <Border Style="{StaticResource AppleWindowInnerPanelStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="2,0,2,10" MouseLeftButtonDown="TitleBar_OnMouseLeftButtonDown">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock VerticalAlignment="Center"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TitleBrush}"
                               Text="{Binding DialogHeading, RelativeSource={RelativeSource AncestorType=Window}}" />
                    <Button Grid.Column="1"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Click="CancelButton_OnClick"
                            ToolTip="关闭"
                            Style="{StaticResource AppleWindowCloseButtonStyle}" />
                </Grid>

                <Border Grid.Row="1" Margin="0,0,0,10" Style="{StaticResource AppleCompactDialogBodyCardStyle}">
                    <Grid>
                        <TextBox x:Name="NameTextBox"
                                 Style="{StaticResource AppleInputTextBoxStyle}"
                                 ToolTip="建议 5 字左右；超出宽度部分在标签栏会自动收起，悬停可查看完整名称"
                                 Text="{Binding CategoryName, RelativeSource={RelativeSource AncestorType=Window}, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Text="例如：常用问候 / 售后问题"
                                   Margin="10,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"
                                   FontSize="13" Foreground="{StaticResource MutedBrush}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=NameTextBox}" Value="">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </Border>

                <Border Grid.Row="2" Style="{StaticResource AppleDialogFooterBarStyle}">
                    <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                        <Button Width="78"
                                Margin="0,0,8,0"
                                Click="CancelButton_OnClick"
                                Content="取消"
                                Style="{StaticResource AppleSecondaryButtonStyle}" />
                        <Button Width="88"
                                IsDefault="True"
                                Click="SaveButton_OnClick"
                                Content="{Binding ConfirmButtonText, RelativeSource={RelativeSource AncestorType=Window}}"
                                Style="{StaticResource ApplePrimaryButtonStyle}" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Border>
</Window>
